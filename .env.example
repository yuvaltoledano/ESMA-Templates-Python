# Copy this file to .env, in the same directory as docker-compose.yml, and
# fill in every value. .env is git-ignored: it is the only place the
# hostname, the login and the password hash live. See docs/deploy.md.

# The hostname the site is served on. Its DNS A record must point at this
# server before the first start, or Caddy cannot obtain a certificate.
# Use "localhost" only for a local test (Caddy then uses a self-signed
# certificate).
SITE_HOST=milan.example.com

# The username typed into the browser's password prompt.
BASIC_AUTH_USER=analyst

# The bcrypt hash of the password (never the password itself). Generate it
# with:
#     docker compose run --rm --no-deps web caddy hash-password
# KEEP THE SINGLE QUOTES around the value: the hash contains "$" characters
# that docker compose would otherwise read as variable references and
# silently mangle, and the password would never be accepted.
BASIC_AUTH_HASH='$2a$14$replace.this.with.the.hash.printed.by.caddy.hash-password'

# Number of API worker processes. Each handles one request at a time, so
# this is also how many analysts can process pools at the same moment.
# 2 suits a 2-vCPU server; raise it after resizing the server.
ESMA_MILAN_WORKERS=2

# Per-client rate limits for the API (format: <count>/<unit>, e.g.
# 10/minute or 100/hour). The counters are kept per worker process, so
# the effective ceiling is the value times ESMA_MILAN_WORKERS.
ESMA_MILAN_RATE_LIMIT_PROCESS=10/minute
ESMA_MILAN_RATE_LIMIT_HEALTH=60/minute

# How long a finished background job (its workbook or analysis result)
# stays on the server before the worker deletes it, in hours. A job's
# input files are deleted as soon as the job finishes, whatever this is.
ESMA_MILAN_JOB_RETENTION_HOURS=12
